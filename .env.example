# Postgres connection string. On Vercel, add the Postgres storage integration
# (Storage tab -> Create Database -> Postgres) and it injects this automatically.
DATABASE_URL="postgresql://user:password@localhost:5432/haru?schema=public"

# Session signing secret. Generate one with: openssl rand -base64 32
# NEVER reuse the same secret across environments.
AUTH_SECRET="replace-me"

# --- Optional: enables features that degrade gracefully without them ---

# Newsletter sending (Resend: https://resend.com). Without this, drafts can
# still be composed in /admin/newsletter but "Send" is disabled.
RESEND_API_KEY=""
NEWSLETTER_FROM_EMAIL="Haru <newsletter@yourdomain.com>"

# Stripe billing (Premium subscription). Without this, /app/upgrade shows the
# plans but the "Subscribe" button reports "coming soon" instead of checking out.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
