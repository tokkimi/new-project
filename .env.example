# Postgres connection string. On Vercel, add the Postgres storage integration
# (Storage tab -> Create Database -> Postgres) and it injects this automatically.
DATABASE_URL="postgresql://user:password@localhost:5432/haru?schema=public"

# Session signing secret. Generate one with: openssl rand -base64 32
# NEVER reuse the same secret across environments.
AUTH_SECRET="replace-me"

# One-time setup token to populate a freshly connected database by visiting
# https://yourdomain.com/api/setup/seed?token=<this value> once in a browser.
# Generate one the same way as AUTH_SECRET. Safe to leave set — the seed
# operations are idempotent (upsert), so re-visiting the URL just re-syncs
# the same data rather than duplicating it. Remove the var afterwards if
# you'd rather close the endpoint entirely.
SEED_SECRET="replace-me"

# --- Optional: enables features that degrade gracefully without them ---

# Newsletter sending (Resend: https://resend.com). Without this, drafts can
# still be composed in /admin/newsletter but "Send" is disabled.
RESEND_API_KEY=""
NEWSLETTER_FROM_EMAIL="Haru <newsletter@yourdomain.com>"

# Stripe billing (Premium subscription). Without this, /app/upgrade shows the
# plans but the "Subscribe" button reports "coming soon" instead of checking out.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# One-time face-scan purchase (9€/scan, for non-subscribers — Premium
# subscribers get unlimited scans automatically). Create a one-time Price in
# Stripe (Product catalog -> new product -> "One time" pricing) and paste its
# price_... id here. Without this, /app/face-scan shows the paywall but the
# "Buy my scan" button reports "coming soon" instead of checking out.
STRIPE_SCAN_PRICE_ID=""

# Real AI vision analysis (Anthropic Claude) for the face scan and product
# scan. Get a key at https://console.anthropic.com/settings/keys. Without
# this, both scan features show an honest "AI analysis not configured" state
# instead of any result — they never fall back to a fake/random one.
ANTHROPIC_API_KEY=""
